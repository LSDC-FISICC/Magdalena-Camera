<?xml version="1.0"?>
<package format="3">
  <name>magdalene_camera_ros</name>
  <version>0.1.0</version>
  <description>ROS2 node for Intel RealSense D555 cameras over Ethernet PoE</description>
  <maintainer email="julio.fajardo@galileo.edu">julio</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>magdalene_camera_sdk</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
